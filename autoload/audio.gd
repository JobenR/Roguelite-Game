extends Node
## Sound, music and vibration. Listens to game events and plays the matching
## sound; a few places call play() directly. Sounds are generated by
## tools/gen_audio.py. Respects the sound, music and vibration settings.

const SOUNDS: Array[String] = ["shoot", "hit", "splat", "gem", "click", "card", "levelup", "milestone", "pulse",
		"fizzle", "bomb", "hurt", "warning", "boss", "glyph", "victory", "death"]
## Shortest gap in milliseconds between two plays of the same sound, so a
## crowd dying at once does not stack into noise.
const MIN_GAP := {"shoot": 70, "hit": 60, "splat": 55, "gem": 45, "click": 40}
const VOLUME := {"shoot": -14.0, "hit": -16.0, "splat": -9.0, "gem": -14.0, "click": -10.0, "card": -4.0,
		"levelup": -3.0, "milestone": -3.0, "pulse": -4.0, "fizzle": -10.0, "bomb": -2.0, "hurt": -3.0,
		"warning": -3.0, "boss": -1.0, "glyph": -3.0, "victory": -1.0, "death": -2.0}
const VOICES := 12

var _streams: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _last_played: Dictionary = {}
var _music: AudioStreamPlayer


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for id in SOUNDS:
		var path := "res://assets/audio/%s.wav" % id
		if ResourceLoader.exists(path):
			_streams[id] = load(path)
	for i in VOICES:
		var player := AudioStreamPlayer.new()
		add_child(player)
		_players.append(player)
	_music = AudioStreamPlayer.new()
	_music.volume_db = -15.0
	add_child(_music)
	if ResourceLoader.exists("res://assets/audio/music.wav"):
		var stream: AudioStreamWAV = load("res://assets/audio/music.wav")
		stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		stream.loop_end = int(stream.get_length() * stream.mix_rate)
		_music.stream = stream
	refresh_music()

	Events.enemy_killed.connect(func(_t: String, _p: Vector2, _r: float, _x: int, _d: Vector2) -> void: play("splat"))
	Events.xp_collected.connect(func(_a: int) -> void: play("gem"))
	Events.level_up.connect(func(_l: int) -> void:
		play("levelup")
		buzz(20))
	Events.upgrade_applied.connect(func(id: String) -> void:
		if id != "":
			play("card"))
	Events.synergy_unlocked.connect(func(_n: String, _d: String) -> void: play("glyph"))
	Events.set_bonus.connect(func(_n: String, _c: int, _d: String) -> void: play("milestone"))
	Events.milestone_reached.connect(func(_p: int, _t: String) -> void: play("milestone"))
	Events.pulse_fired.connect(func(cells: int) -> void:
		play("pulse" if cells > 0 else "fizzle")
		if cells > 0:
			buzz(30))
	Events.glyph_triggered.connect(func(_k: String, _s: float) -> void:
		play("glyph")
		buzz(50))
	Events.player_hurt.connect(func() -> void:
		play("hurt")
		buzz(60))
	Events.player_died.connect(func() -> void: play("death"))
	Events.wave_warning.connect(func(_n: int, _s: float, _l: String) -> void: play("warning"))
	Events.alert.connect(func(_t: String, _s: float) -> void: play("warning"))
	Events.boss_spawned.connect(func(_n: String) -> void:
		play("boss")
		buzz(120))
	Events.boss_defeated.connect(func(_n: String) -> void: play("bomb"))
	Events.final_boss_defeated.connect(func() -> void: play("victory"))


func play(id: String, pitch_spread: float = 0.07) -> void:
	if not SaveData.setting("sound") or not _streams.has(id):
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(id, -1000)) < int(MIN_GAP.get(id, 0)):
		return
	_last_played[id] = now
	var player := _players[_next_voice]
	_next_voice = (_next_voice + 1) % VOICES
	player.stream = _streams[id]
	player.volume_db = float(VOLUME.get(id, -6.0))
	player.pitch_scale = 1.0 + randf_range(-pitch_spread, pitch_spread)
	player.play()


## Starts or stops the music to match the setting.
func refresh_music() -> void:
	if _music.stream == null:
		return
	if SaveData.setting("music"):
		if not _music.playing:
			_music.play()
	else:
		_music.stop()


## A short vibration on phones, if the setting allows.
func buzz(milliseconds: int) -> void:
	if SaveData.setting("vibration"):
		Input.vibrate_handheld(milliseconds)
