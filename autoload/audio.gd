extends Node
## Sound, music and vibration. Listens to game events and plays the matching
## sound; a few places call play() directly. Everything is generated by
## tools/gen_audio.py. Respects the sound, music and vibration settings.
##
## Music: a calm plucked koto line for normal play, and three "pressure"
## tracks for boss fights: one slow, down-tuned, heavily distorted guitar
## riff, each tier heavier than the last. A boss switches to pressure; the tier rises with each boss met in the run (first boss tier 1,
## second tier 2, third and the final boss tier 3). It eases back to calm a
## few seconds after the boss dies.

const SOUNDS: Array[String] = ["shoot", "hit", "splat", "gem", "click", "card", "levelup", "milestone", "pulse",
		"fizzle", "bomb", "hurt", "warning", "boss", "glyph", "victory", "death"]
## Shortest gap in milliseconds between two plays of the same sound, so a
## crowd dying at once does not stack into noise.
const MIN_GAP := {"shoot": 85, "hit": 70, "splat": 60, "gem": 40, "click": 40}
const VOLUME := {"shoot": -19.0, "hit": -21.0, "splat": -11.0, "gem": -15.0, "click": -10.0, "card": -4.0,
		"levelup": -3.0, "milestone": -3.0, "pulse": -3.0, "fizzle": -10.0, "bomb": -3.0, "hurt": -3.0,
		"warning": -3.0, "boss": -1.0, "glyph": -3.0, "victory": -1.0, "death": -2.0}
const PITCH_SPREAD := {"shoot": 0.16, "hit": 0.2, "splat": 0.18, "gem": 0.0}
const VOICES := 12
const MUSIC_DB := -14.0
const SILENT_DB := -60.0
const FADE_SECONDS := 1.6
const COOL_DOWN := 4.0   # seconds of pressure music after the boss is gone

var _streams: Dictionary = {}   # id -> Array of AudioStream (variants)
var _players: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _last_played: Dictionary = {}
var _last_variant: Dictionary = {}
var _gem_step: int = 0
var _tracks: Array[AudioStreamPlayer] = []   # 0 = calm, 1..3 = pressure tiers
var _levels: Array[float] = [1.0, 0.0, 0.0, 0.0]
var _bosses_met: int = 0
var _boss_alive: bool = false
var _cool_left: float = 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for id in SOUNDS:
		var variants: Array = []
		if ResourceLoader.exists("res://assets/audio/%s.wav" % id):
			variants.append(load("res://assets/audio/%s.wav" % id))
		var n := 1
		while ResourceLoader.exists("res://assets/audio/%s%d.wav" % [id, n]):
			variants.append(load("res://assets/audio/%s%d.wav" % [id, n]))
			n += 1
		if not variants.is_empty():
			_streams[id] = variants
	for i in VOICES:
		var player := AudioStreamPlayer.new()
		add_child(player)
		_players.append(player)
	_tracks.append(_music_player("res://assets/audio/music.wav"))
	for tier in range(1, 4):
		_tracks.append(_music_player("res://assets/audio/music_pressure%d.wav" % tier))
	refresh_music()

	Events.enemy_killed.connect(func(_t: String, _p: Vector2, _r: float, _x: int, _d: Vector2) -> void: play("splat"))
	Events.xp_collected.connect(func(_a: int) -> void: play("gem"))
	Events.level_up.connect(func(_l: int) -> void:
		play("levelup")
		buzz(20))
	Events.upgrade_applied.connect(func(id: String) -> void:
		if id != "":
			play("card"))
	Events.synergy_unlocked.connect(func(_n: String, _d: String) -> void: play("glyph"))
	Events.set_bonus.connect(func(_n: String, _c: int, _d: String) -> void: play("milestone"))
	Events.milestone_reached.connect(func(_p: int, _t: String) -> void: play("milestone"))
	Events.pulse_fired.connect(func(_cells: int) -> void:
		play("pulse")
		play("bomb")
		buzz(70))
	Events.player_hurt.connect(func() -> void:
		play("hurt")
		buzz(60))
	Events.player_died.connect(func() -> void:
		play("death")
		calm())
	Events.wave_warning.connect(func(_n: int, _s: float, _l: String) -> void: play("warning"))
	Events.alert.connect(func(_t: String, _s: float) -> void: play("warning"))
	Events.run_started.connect(func() -> void:
		_bosses_met = 0
		calm())
	Events.boss_spawned.connect(func(_n: String) -> void:
		play("boss")
		buzz(120)
		_bosses_met += 1
		_boss_alive = true)
	Events.boss_defeated.connect(func(_n: String) -> void:
		play("bomb")
		_boss_alive = false
		_cool_left = COOL_DOWN)
	Events.final_boss_defeated.connect(func() -> void: play("victory"))


func _music_player(path: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.volume_db = SILENT_DB
	add_child(player)
	if ResourceLoader.exists(path):
		var stream: AudioStreamWAV = load(path)
		stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		stream.loop_end = int(stream.get_length() * stream.mix_rate)
		player.stream = stream
	return player


func play(id: String) -> void:
	if not SaveData.setting("sound") or not _streams.has(id):
		return
	var now := Time.get_ticks_msec()
	var since := now - int(_last_played.get(id, -100000))
	if since < int(MIN_GAP.get(id, 0)):
		return
	_last_played[id] = now
	var variants: Array = _streams[id]
	var pick := 0
	if id == "gem":
		# Gems picked up in a quick run climb the scale; a pause starts over.
		_gem_step = (_gem_step + 1) % variants.size() if since < 700 else 0
		pick = _gem_step
	elif variants.size() > 1:
		# Never the same variant twice in a row.
		pick = randi() % variants.size()
		if pick == int(_last_variant.get(id, -1)):
			pick = (pick + 1) % variants.size()
		_last_variant[id] = pick
	var player := _players[_next_voice]
	_next_voice = (_next_voice + 1) % VOICES
	player.stream = variants[pick]
	player.volume_db = float(VOLUME.get(id, -6.0)) + randf_range(-1.5, 0.5)
	var spread := float(PITCH_SPREAD.get(id, 0.07))
	player.pitch_scale = 1.0 + randf_range(-spread, spread)
	player.play()


## Back to the calm track at once (title screen, death, a new run).
func calm() -> void:
	_boss_alive = false
	_cool_left = 0.0


## Starts or stops the music to match the setting.
func refresh_music() -> void:
	if _tracks.is_empty() or _tracks[0].stream == null:
		return
	if SaveData.setting("music"):
		if not _tracks[0].playing:
			_tracks[0].play()
	else:
		for track in _tracks:
			track.stop()


func _process(delta: float) -> void:
	if _tracks.is_empty() or not SaveData.setting("music"):
		return
	if not _boss_alive and _cool_left > 0.0:
		_cool_left -= delta
	var wanted := clampi(_bosses_met, 1, 3) if (_boss_alive or _cool_left > 0.0) else 0
	for i in _tracks.size():
		var track := _tracks[i]
		if track.stream == null:
			continue
		_levels[i] = move_toward(_levels[i], 1.0 if i == wanted else 0.0, delta / FADE_SECONDS)
		if _levels[i] > 0.0 and not track.playing:
			track.play()   # a pressure track starts from its top each time
		elif _levels[i] <= 0.0 and track.playing and i != 0:
			track.stop()
		track.volume_db = lerpf(SILENT_DB, MUSIC_DB, sqrt(_levels[i]))


## A short vibration on phones, if the setting allows.
func buzz(milliseconds: int) -> void:
	if SaveData.setting("vibration"):
		Input.vibrate_handheld(milliseconds)
